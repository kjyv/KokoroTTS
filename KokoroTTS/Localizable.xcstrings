    "%@ %@ %@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$@%4$@"
          }
        }
      }
    },
    "• **M4A** (AAC) - Compressed, smaller file size, widely compatible": {
      "comment": "M4A format description in help window",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A** (AAC) – Komprimiert, kleinere Dateigröße, weit verbreitet kompatibel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A** (AAC) – Comprimido, menor tamaño de archivo, ampliamente compatible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A** (AAC) – Compressé, fichier plus petit, largement compatible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A** (AAC) – Compresso, file più piccolo, ampiamente compatibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A**（AAC）– 圧縮、ファイルサイズ小、幅広い互換性"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A** (AAC) – Comprimido, arquivo menor, amplamente compatível"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A**（AAC）– 压缩格式，文件较小，兼容性广"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• **M4A** (AAC) – संपीडित, छोटा फ़ाइल आकार, व्यापक रूप से संगत"
          }
        }
      }
    },
    "• **WAV** - Uncompressed, highest quality, larger file size": {
      "comment": "WAV format description in help window",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – Unkomprimiert, höchste Qualität, größere Dateigröße"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – Sin comprimir, máxima calidad, mayor tamaño de archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – Non compressé, qualité maximale, fichier plus volumineux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – Non compresso, qualità massima, file più grande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – 非圧縮、最高品質、ファイルサイズ大"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – Sem compressão, qualidade máxima, arquivo maior"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – 无压缩，最高品质，文件较大"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• **WAV** – असंपीडित, सर्वोच्च गुणवत्ता, बड़ा फ़ाइल आकार"
          }
        }
      }
    },
    "A macOS application for the Kokoro TTS (Text-to-Speech) model, allowing high-quality offline speech synthesis. Integrates as a macOS service to speak selected text quickly.": {
      "comment": "App description in the help window",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine macOS-App für das Kokoro-TTS-Modell (Text-to-Speech), die hochwertige Offline-Sprachsynthese ermöglicht. Integriert sich als macOS-Dienst, um markierten Text schnell vorzulesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una aplicación de macOS para el modelo Kokoro TTS (texto a voz), que permite una síntesis de voz de alta calidad sin conexión. Se integra como servicio de macOS para leer rápidamente el texto seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une application macOS pour le modèle Kokoro TTS (synthèse vocale), permettant une synthèse vocale hors ligne de haute qualité. S'intègre comme service macOS pour lire rapidement le texte sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’applicazione macOS per il modello Kokoro TTS (Text-to-Speech), che consente la sintesi vocale offline di alta qualità. Si integra come servizio macOS per leggere rapidamente il testo selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoro TTS（テキスト読み上げ）モデル用のmacOSアプリケーションで、高品質なオフライン音声合成を実現します。macOSサービスとして統合され、選択したテキストをすばやく読み上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aplicativo macOS para o modelo Kokoro TTS (texto para fala), permitindo síntese de voz offline de alta qualidade. Integra-se como serviço macOS para ler rapidamente o texto selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款使用 Kokoro TTS（文本转语音）模型的 macOS 应用程序，支持高质量的离线语音合成。作为 macOS 服务集成，可快速朗读所选文本。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoro TTS (टेक्स्ट-टू-स्पीच) मॉडल के लिए एक macOS एप्लिकेशन, जो उच्च गुणवत्ता वाली ऑफ़लाइन वाक् संश्लेषण प्रदान करता है। चयनित टेक्स्ट को तुरंत पढ़ने के लिए macOS सेवा के रूप में एकीकृत होता है।"
          }
        }
      }
    },
